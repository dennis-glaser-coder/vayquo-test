  function v24Result(title,copy,stats,note,demo){return `<div class="v24-result"><div class="label">${demo?'VAYQUO DEMO-EINORDNUNG':'VAYQUO EINORDNUNG'}</div><h4>${esc(title)}</h4><p>${esc(copy)}</p><div class="v24-result-grid">${stats.map(([k,v])=>`<div class="v24-result-stat"><small>${esc(k)}</small><b>${esc(v)}</b></div>`).join('')}</div><div class="v24-result-note">${esc(note)}</div></div>`}
  function v24CalcFlight(){
    const prog=document.getElementById('fProgram').value,price=Math.max(0,+document.getElementById('fCash').value||0),award=Math.max(0,+document.getElementById('fAward').value||0),fees=Math.max(0,+document.getElementById('fFees').value||0),have=Math.max(0,+document.getElementById('fHave').value||0),min=Math.max(0,+document.getElementById('fMin').value||1),from=document.getElementById('fFrom').value.trim().toUpperCase(),to=document.getElementById('fTo').value.trim().toUpperCase(),cabin=document.getElementById('fCabin').value,date=document.getElementById('fDate').value,demo=document.getElementById('v24AwardBox').dataset.demo==='1';
    if(!price||!award){toast('Flug auswählen und Prämienpreis ergänzen');return}if(fees>=price){toast('Gebühren müssen unter dem Barpreis liegen');return}state.minCpp=min;const net=price-fees,gap=Math.max(0,award-have),route=`${from||'—'} → ${to||'—'}`;let title='',copy='',stats=[],note='';
    if(prog==='milesmore'){
      const val=net/award*100,pb=state.programs.pb?state.balances.pb:0,enough=gap===0||pb>=gap;if(gap===0){title='Deine Meilen reichen für diesen Flug';copy=`Der rechnerische Gegenwert liegt bei ${dec(val)} Cent pro Miles-&-More-Meile.`}else if(!state.programs.pb){title='Für diesen Flug fehlen noch Meilen';copy=`Dir fehlen ${num(gap)} Miles-&-More-Meilen. PAYBACK ist nicht als Zufluss hinterlegt.`}else if(!enough){title='Ziel noch nicht erreichbar';copy=`Dir fehlen ${num(gap)} Meilen; dein PAYBACK-Bestand deckt davon ${num(Math.min(pb,gap))}.`}else if(val>1){title='PAYBACK-Transfer ist rechnerisch interessant';copy=`Der Flug liefert rund ${dec(val)} Cent Gegenwert je Meile und liegt damit über dem sicheren PAYBACK-Geldwert.`}else{title='PAYBACK als Geld ist hier stärker';copy=`Der Flug liefert rund ${dec(val)} Cent Gegenwert je Meile.`}stats=[['Cash-Ersparnis',money(net)],['Wert je Meile',`${dec(val)} ct`],['Fehlende Meilen',num(gap)]];note=`${route}${date?' · '+date:''} · ${cabin}. ${demo?'Demo-Barpreis – nicht als Live-Angebot verwenden. ':''}Award-Preis und Verfügbarkeit final prüfen.`;state.last={type:'flight',program:'milesmore',route,price,award,fees,gap,summary:title,detail:copy};save();document.getElementById('fRes').innerHTML=v24Result(title,copy,stats,note,demo);return;
    }
    const p=partner(prog);if(!p||!p.active){toast('Transferpartner nicht verfügbar');return}let mr=gap?needed(gap,p):0;if(gap&&mr<p.min)mr=p.min;const enough=gap===0||state.balances.mr>=mr,alloc=gap?net*(gap/award):0,cpp=mr?alloc/mr*100:net/award*100;if(gap===0){title='Kein Transfer nötig';copy=`Dein Bestand bei ${p.name} reicht bereits.`}else if(!enough&&cpp>=min){title='Gute Einlösung – aber Punkte fehlen';copy=`Für den fehlenden Teil brauchst du rechnerisch ${num(mr)} Membership-Rewards-Punkte.`}else if(enough&&cpp>=min){title='Transfer für diesen Flug interessant';copy=`Der fehlende Teil liefert rund ${dec(cpp)} Cent Gegenwert pro benötigtem Membership-Rewards-Punkt.`}else{title='Cash ist wahrscheinlich stärker';copy=`Der Gegenwert liegt mit rund ${dec(cpp)} Cent unter deiner Schwelle von ${dec(min)} Cent.`}stats=[['Benötigte Punkte',gap?num(mr):'0'],['Dein Punktestand',num(state.balances.mr)],['Wert je Punkt',gap?`${dec(cpp)} ct`:'—']];note=`${route}${date?' · '+date:''} · ${p.name}. ${demo?'Demo-Barpreis – nicht als Live-Angebot verwenden. ':''}Award-Verfügbarkeit und finalen Preis vor dem Transfer prüfen.`;state.last={type:'flight',program:p.id,route,price,award,fees,mr,enough,cpp,summary:title,detail:copy};save();document.getElementById('fRes').innerHTML=v24Result(title,copy,stats,note,demo);
  }

  const v24BaseRenderTool=renderTool;
  renderTool=function(){if(tool==='flight'){v24RenderFlight();return}v24BaseRenderTool()};
  renderOptimize=function(){
    app.innerHTML=`<section class="screen"><div class="v17-card-head"><div><div class="minor">Konkrete Entscheidungen</div><h1>Prüfen</h1></div></div><div class="choice-list">${(state.programs.mr||state.programs.mm||state.programs.pb)?choice('flight','plane','Flug mit Punkten prüfen','Flug auswählen und anschließend Punktebuchung einordnen'):''}${state.programs.mr?choice('transfer','transfer','Transferbedarf prüfen','Benötigte Punkte für ein konkretes Ziel berechnen'):''}${state.programs.mr?choice('cash','scale','Cash oder Punkte?','Konkrete Buchung vergleichen'):''}${state.programs.mr?choice('matrix','globe','Punkte bei Partnern','Reine Umrechnung zu Airlines & Hotels'):''}${state.programs.pb?choice('payback','euro','PAYBACK → Miles & More','Geldwert und Meilenziel vergleichen'):''}</div><div id="toolHost"></div></section>`;
