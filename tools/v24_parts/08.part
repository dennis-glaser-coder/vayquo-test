    if(state.card!=='platinum'){v24BaseCard();return}const setup=benefitSetup(),open=setup?remainingVorteile():650,used=usedVorteile();app.innerHTML=`<section class="screen"><div class="v19-head"><div><div class="over">AMERICAN EXPRESS PLATINUM</div><h1>Vorteile</h1></div><button class="v19-card-change" id="v24Switch">Karte ändern</button></div><div class="v19-benefits"><div class="v19-benefits-top"><div><div class="minor">${setup?'NOCH OFFEN':'GUTHABEN 2026'}</div><div class="amount">${setup?money(open):'650 €'}</div><div class="copy">${setup?`${money(used)} als genutzt markiert`:'Klar bezifferbare Guthaben plus Reisevorteile'}</div></div></div><button class="v19-benefit-cta" id="v24Setup">${setup?'Nutzung aktualisieren':'Nutzung einrichten'}</button></div><div class="v19-section"><div class="v19-section-head"><h2>Guthaben direkt nutzen</h2></div><div class="v19-benefit-list">${v24BenefitRow('plane','Online-Reiseguthaben',state.benefits.travel,200,benefitPeriod('travel'),'Nutzung aktualisieren','v24Travel')}${v24BenefitRow('euro','Restaurantguthaben',state.benefits.restaurant,150,benefitPeriod('restaurant'),'Restaurant Finder öffnen','v24Restaurant')}${v24BenefitRow('transfer','SIXT ride',sixtUsed(),200,benefitPeriod('sixt'),'SIXT ride öffnen','v24Sixt')}${v24BenefitRow('card','LODENFREY',(+state.benefits.lodenH1||0)+(+state.benefits.lodenH2||0),100,'2 × 50 €','Nutzung aktualisieren','v24Loden')}</div></div><div class="v19-section"><div class="v19-section-head"><h2>Unterwegs</h2></div><div class="v24-travel-actions"><button class="v24-travel-card" id="v24Lounges"><span class="ico">${ic('plane')}</span><span><strong>Lounge Finder</strong><span>Flughafen eingeben und aktuelle Zugänge prüfen.</span></span><span class="go">›</span></button><button class="v24-travel-card" id="v24BenefitFlight"><span class="ico">${ic('scale')}</span><span><strong>Flug mit Punkten prüfen</strong><span>Erst Flug auswählen, dann Punktebuchung bewerten.</span></span><span class="go">›</span></button></div></div></section>`;document.getElementById('v24Switch').onclick=openCardSwitch;document.getElementById('v24Setup').onclick=openV15BenefitSetup;document.getElementById('v24Travel').onclick=openV15BenefitSetup;document.getElementById('v24Restaurant').onclick=v24OpenRestaurant;document.getElementById('v24Sixt').onclick=v24OpenSixt;document.getElementById('v24Loden').onclick=openV15BenefitSetup;document.getElementById('v24Lounges').onclick=v24OpenLounges;document.getElementById('v24BenefitFlight').onclick=()=>go('optimize','flight');
  };

  const navLabels={today:'Start',optimize:'Prüfen',wallet:'Punkte',card:'Vorteile'};document.querySelectorAll('#bottom [data-view]').forEach(b=>{const s=b.querySelector('span:last-child');if(s)s.textContent=navLabels[b.dataset.view]||s.textContent});
  if(view==='today'||view==='optimize'||view==='card')render();
})();
</script>
