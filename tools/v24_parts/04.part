    openModal('Mehr Punkte sammeln',`<div class="v24-modal-lead"><strong>Aktuelle Aktionen statt statischer Listen.</strong><br>Persönliche Offers und Coupons sind ohne Login/API noch nicht automatisch ausgelesen. VAYQUO führt dich deshalb zu den aktuellen Quellen.</div><div class="modal-actions"><button class="modal-action" id="v24AmexOffers"><i>${ic('card')}</i><span><strong>Amex Offers</strong><span>Aktuelle Offers öffnen.</span></span>${ic('arrow')}</button><button class="modal-action" id="v24Payback"><i>${ic('euro')}</i><span><strong>PAYBACK Coupons</strong><span>Persönliche Coupons nach Login ansehen.</span></span>${ic('arrow')}</button><button class="modal-action" id="v24Miles"><i>${ic('plane')}</i><span><strong>Miles & More Angebote</strong><span>Aktuelle Sammel- und Partnerangebote.</span></span>${ic('arrow')}</button></div><div class="notice light">Screenshot-Erkennung für persönliche Angebote ist als nächster Scan-Schritt vorbereitet, aber in V2.4 noch nicht automatisch aktiv.</div>`);
    document.getElementById('v24AmexOffers').onclick=()=>v24OpenPartner('amex-offers',V24_URLS.amexOffers);document.getElementById('v24Payback').onclick=()=>v24OpenPartner('payback-coupons',V24_URLS.paybackCoupons);document.getElementById('v24Miles').onclick=()=>v24OpenPartner('miles-offers',V24_URLS.milesOffers);
  }

  function v24Help(title,text){openModal(title,`<div class="v24-modal-lead">${text}</div>`)}
  function v24HelpButton(key){return `<button type="button" class="v24-help" data-v24-help="${key}" aria-label="Hilfe">?</button>`}
  const V24_HELP={award:['Prämienpreis','Die Anzahl Punkte oder Meilen, die das Vielfliegerprogramm für genau diesen Flug verlangt.'],fees:['Steuern & Gebühren','Der Geldbetrag, der bei einer Prämienbuchung zusätzlich zu Punkten oder Meilen anfällt.'],have:['Schon vorhanden','Punkte oder Meilen, die bereits im gewählten Zielprogramm liegen. VAYQUO zieht sie vor einem Transfer ab.'],min:['Mindestwert','Deine persönliche Untergrenze pro Membership-Rewards-Punkt. Liegt der Gegenwert darunter, ist Barzahlung meist stärker.'],cash:['Barpreis','Der normale Preis desselben Fluges. Er ist nötig, um den echten Gegenwert der Punktebuchung zu vergleichen.']};
  function v24BindHelp(){document.querySelectorAll('[data-v24-help]').forEach(b=>b.onclick=()=>{const h=V24_HELP[b.dataset.v24Help];if(h)v24Help(h[0],h[1])})}
  function v24FlightProgramOptions(){
    const a=[];if(state.programs.mm||state.programs.pb)a.push(`<option value="milesmore">Miles & More${state.programs.pb?' · PAYBACK möglich':''}</option>`);if(state.programs.mr)PARTNERS.filter(p=>p.group==='Airline'&&p.active).forEach(p=>a.push(`<option value="${p.id}">${p.name} · Membership Rewards</option>`));return a.join('');
  }
  function v24HaveDefault(id){return id==='milesmore'?state.balances.mm:0}
  function v24DemoFlights(cabin){const base={Economy:520,'Premium Economy':790,Business:1850,First:4200}[cabin]||520;return[{id:'d1',name:'Direktflug',meta:'Beispiel · kürzeste Verbindung',price:base},{id:'d2',name:'1 Stopp',meta:'Beispiel · günstigere Verbindung',price:Math.round(base*.76/10)*10},{id:'d3',name:'Flexible Option',meta:'Beispiel · anderer Tarif',price:Math.round(base*1.12/10)*10}]}
  function v24RenderFlight(){
    const h=document.getElementById('toolHost');if(!h)return;
