    document.querySelectorAll('[data-tool]').forEach(b=>b.onclick=()=>{tool=b.dataset.tool;renderTool();setTimeout(()=>document.getElementById('toolHost')?.scrollIntoView({behavior:'smooth',block:'start'}),20)});if(tool)renderTool();
  };

  function v24OpenRestaurant(){const left=Math.max(0,150-(+state.benefits.restaurant||0));openModal('Restaurant Finder',`<div class="v24-modal-lead"><strong>${money(left)} Restaurantguthaben noch offen.</strong><br>Gib deinen Ort ein. Solange keine Restaurant-API angebunden ist, öffnet VAYQUO bewusst die aktuelle offizielle Liste statt veraltete Restaurants zu speichern.<div class="v24-source-pill">Aktuelle Quelle · American Express</div></div><div class="field"><label>Ort oder Stadt</label><input class="input" id="v24RestaurantPlace" placeholder="z. B. Düsseldorf"></div><button class="btn" id="v24RestaurantGo">Teilnehmende Restaurants anzeigen</button><button class="btn outline" id="v24RestaurantTerms">Bedingungen prüfen</button>`);document.getElementById('v24RestaurantGo').onclick=()=>{if(!document.getElementById('v24RestaurantPlace').value.trim()){toast('Ort eingeben');return}v24OpenPartner('amex-restaurants',V24_URLS.restaurant)};document.getElementById('v24RestaurantTerms').onclick=()=>v24OpenPartner('amex-restaurant-terms',V24_URLS.restaurantTerms)}
  function v24OpenLounges(){openModal('Lounge Finder',`<div class="v24-modal-lead"><strong>Welche Lounge passt zu deinem Flug?</strong><br>Flughafen und optional Terminal eingeben. Ohne Live-Lounge-API führt VAYQUO dich zu den aktuellen offiziellen Findern, statt Öffnungszeiten oder Zugänge zu erfinden.</div><div class="v23-flight-route"><div class="field"><label>Flughafen</label><input class="input" id="v24Airport" placeholder="DUS"></div><div class="field"><label>Terminal <small>optional</small></label><input class="input" id="v24Terminal" placeholder="z. B. B"></div></div><button class="btn" id="v24AmexLounge">Amex Lounge-Finder öffnen</button><button class="btn outline" id="v24Priority">Priority Pass gegenprüfen</button><button class="btn outline" id="v24LoungeFlight">Diesen Flug mit Punkten prüfen</button>`);document.getElementById('v24AmexLounge').onclick=()=>{if(!document.getElementById('v24Airport').value.trim()){toast('Flughafen eingeben');return}v24OpenPartner('amex-lounges',V24_URLS.lounges)};document.getElementById('v24Priority').onclick=()=>v24OpenPartner('priority-pass',V24_URLS.priorityPass);document.getElementById('v24LoungeFlight').onclick=()=>{closeModal();go('optimize','flight')}}
  function v24OpenSixt(){const left=Math.max(0,200-sixtUsed());openModal('SIXT ride',`<div class="v24-modal-lead"><strong>${money(left)} des hinterlegten SIXT-ride-Guthabens noch offen.</strong><br>Plane deine Fahrt und öffne anschließend SIXT ride. VAYQUO kann die Nutzung danach weiter in deinen Vorteilen berücksichtigen.</div><div class="v23-flight-route"><div class="field"><label>Abholung <small>optional</small></label><input class="input" id="v24SixtFrom" placeholder="z. B. DUS"></div><div class="field"><label>Ziel <small>optional</small></label><input class="input" id="v24SixtTo" placeholder="Hotel / Adresse"></div></div><button class="btn" id="v24SixtGo">SIXT ride öffnen</button><button class="btn outline" id="v24SixtUpdate">Nutzung aktualisieren</button>`);document.getElementById('v24SixtGo').onclick=()=>v24OpenPartner('sixt-ride',V24_URLS.sixtRide);document.getElementById('v24SixtUpdate').onclick=()=>{closeModal();openV15BenefitSetup()}}
  const v24BaseCard=renderCard;
  function v24BenefitRow(icon,name,used,max,period,action,id){const setup=benefitSetup();return `<div class="v24-benefit-wrap"><div class="v19-benefit-row"><span class="ico">${ic(icon)}</span><div><strong>${name}</strong><span>${period}</span></div><div class="side"><b>${setup?money(Math.max(0,max-(+used||0))):money(max)}</b><small>${setup?'offen':'enthalten'}</small></div></div><button class="v24-benefit-use" id="${id}">${action} →</button></div>`}
  renderCard=function(){
