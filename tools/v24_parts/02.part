.v24-help{appearance:none;width:19px;height:19px;display:inline-grid;place-items:center;margin-left:5px;padding:0;border:1px solid rgba(22,23,23,.14);border-radius:50%;background:#f0ece5;color:#6e6a63;font-size:10px;font-weight:800;vertical-align:middle}.v24-step{margin-top:13px;padding:16px;border:1px solid rgba(22,23,23,.075);border-radius:20px;background:#fffefa}.v24-step-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:4px}.v24-step-head strong{font-size:13px;color:#292a27}.v24-step-head span{font-size:8.5px;letter-spacing:.12em;color:#9a7a45;font-weight:800}.v24-search-btn{margin-top:13px}.v24-demo-note{margin-top:12px;padding:10px 12px;border-radius:14px;background:#f0ece5;color:#77736c;font-size:9px;line-height:1.45}.v24-flight-list{display:grid;gap:8px;margin-top:10px}.v24-flight-option{width:100%;display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;padding:13px 14px;border:1px solid rgba(22,23,23,.08);border-radius:16px;background:#fff;text-align:left}.v24-flight-option.active{border-color:rgba(151,119,64,.38);box-shadow:0 0 0 2px rgba(151,119,64,.07)}.v24-flight-option strong{display:block;font-size:11.5px;color:#292a27}.v24-flight-option span{display:block;margin-top:3px;font-size:8.8px;color:#85827b}.v24-flight-option .price{text-align:right}.v24-flight-option .price b{font-size:13px;color:#2d2e2b}.v24-flight-option .price small{display:block;margin-top:3px;font-size:7.8px;color:#9a7a45}.v24-award-box{display:none}.v24-award-box.visible{display:block}.v24-screenshot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:12px;padding:11px 12px;border:1px dashed rgba(22,23,23,.15);border-radius:15px;background:#faf7f1}.v24-screenshot span{font-size:9px;line-height:1.35;color:#77736d}.v24-screenshot button{flex:none;min-height:34px;padding:0 10px;border:0;border-radius:10px;background:#242525;color:#fff;font-size:9px;font-weight:760}.v24-scan-status{margin-top:8px;font-size:8.7px;line-height:1.4;color:#7f7b74}.v24-manual{margin-top:10px;border-top:1px solid rgba(22,23,23,.06);padding-top:4px}.v24-manual summary{cursor:pointer;padding:9px 0;font-size:9px;color:#77736c;font-weight:700}.v24-manual[open] summary{color:#5b4930}
.v24-modal-lead{margin-bottom:12px;padding:13px 14px;border-radius:17px;background:#eee9e1;border:1px solid rgba(22,23,23,.06);font-size:10px;line-height:1.5;color:#686660}.v24-modal-lead strong{color:#333431}.v24-source-pill{display:inline-flex;margin-top:7px;padding:6px 8px;border-radius:999px;background:#f5f1ea;border:1px solid rgba(22,23,23,.055);font-size:8.3px;font-weight:740;color:#7d6338}.v24-benefit-wrap{background:rgba(255,254,250,.9);border:1px solid rgba(22,23,23,.085);border-radius:19px;overflow:hidden;box-shadow:0 6px 18px rgba(20,20,20,.028)}.v24-benefit-wrap .v19-benefit-row{border:0!important;border-radius:0!important;box-shadow:none!important;background:transparent!important}.v24-benefit-use{width:100%;min-height:40px;padding:0 14px;border:0;border-top:1px solid rgba(22,23,23,.06);background:#f2eee7;color:#755b34;text-align:left;font-size:9.7px;font-weight:770}.v24-travel-actions{display:grid;gap:9px;margin-top:10px}.v24-travel-card{width:100%;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:11px;padding:14px;border:1px solid rgba(22,23,23,.085);border-radius:18px;background:rgba(255,254,250,.92);text-align:left}.v24-travel-card .ico{width:36px;height:36px;display:grid;place-items:center;border-radius:11px;background:#1b1c1c;color:#ead9b6}.v24-travel-card .ico svg{width:16px;height:16px}.v24-travel-card strong{display:block;font-size:12px;color:#252624}.v24-travel-card span{display:block;margin-top:3px;font-size:9px;line-height:1.4;color:#85837e}.v24-travel-card .go{font-size:17px;color:#9b978f}.v24-result{margin-top:13px;padding:17px;border-radius:22px;background:linear-gradient(150deg,#242525,#151616 76%);border:1px solid rgba(199,166,106,.20);color:#fff;box-shadow:0 16px 36px rgba(18,18,18,.14)}.v24-result .label{font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;color:#d7b77d;font-weight:800}.v24-result h4{margin:8px 0 4px;font-size:20px;line-height:1.08;letter-spacing:-.035em}.v24-result p{margin:0;font-size:10px;line-height:1.45;color:#aaa79f}.v24-result-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:14px}.v24-result-stat{padding:10px 8px;border-radius:13px;background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.06)}.v24-result-stat small{display:block;font-size:7.5px;color:#aaa79f}.v24-result-stat b{display:block;margin-top:4px;font-size:12px;color:#fff}.v24-result-note{margin-top:12px;padding-top:11px;border-top:1px solid rgba(255,255,255,.08);font-size:8.8px;line-height:1.45;color:#aaa79f}
@media(max-width:390px){.v24-hero{padding:24px 20px 20px}.v24-hero h1{font-size:31px}.v24-actions{gap:6px}.v24-action{padding:11px 8px}.v24-program{min-width:91px}.v24-result-grid{gap:5px}.v24-result-stat{padding:9px 6px}}
</style>
