<style id="v24-direct-ux">
/* V2.4 — direct view logic. No cross-view DOM observer. */
.v24-homebar{display:flex;align-items:center;justify-content:space-between;margin:7px 2px 12px;color:#918e87;font-size:9.5px}.v24-homebar strong{font-size:11px;color:#5f5d58;font-weight:700}
.v24-hero{position:relative;overflow:hidden;padding:27px 23px 22px;border-radius:30px;background:radial-gradient(320px 170px at 100% 0%,rgba(199,166,106,.13),transparent 66%),linear-gradient(150deg,#242525,#151616 72%);border:1px solid rgba(199,166,106,.28);box-shadow:0 24px 58px rgba(18,18,18,.20);color:#fff}.v24-hero:after{content:"";position:absolute;width:210px;height:210px;right:-136px;bottom:-144px;border:1px solid rgba(234,217,182,.10);border-radius:50%;box-shadow:0 0 0 38px rgba(255,255,255,.009),0 0 0 76px rgba(255,255,255,.005)}
.v24-kicker{position:relative;z-index:1;font-size:8.3px;letter-spacing:.19em;color:#d2b67e;font-weight:820;text-transform:uppercase}.v24-hero h1{position:relative;z-index:1;margin:11px 0 9px;font-size:34px;line-height:1.01;letter-spacing:-.055em;font-weight:740;color:#fff}.v24-hero p{position:relative;z-index:1;margin:0;max-width:92%;font-size:11.5px;line-height:1.5;color:#bbb8b1}.v24-hero-stat{position:relative;z-index:1;margin-top:17px;padding-top:15px;border-top:1px solid rgba(255,255,255,.08);display:flex;align-items:flex-end;justify-content:space-between;gap:12px}.v24-hero-stat b{font-size:27px;letter-spacing:-.045em;color:#f4eee3}.v24-hero-stat span{font-size:9px;color:#aaa69e;text-align:right}.v24-hero-actions{position:relative;z-index:1;display:flex;align-items:center;gap:11px;margin-top:17px}.v24-hero-main{min-height:44px;padding:0 17px;border:0;border-radius:14px;background:#f5f1e9;color:#1b1c1c;font-size:10.8px;font-weight:780}.v24-why{border:0;background:transparent;color:#c8c4bb;font-size:10px;font-weight:700;padding:8px 2px}
.v24-program-box{margin-top:15px;padding:14px;border-radius:20px;background:rgba(255,254,250,.86);border:1px solid rgba(22,23,23,.075);box-shadow:0 8px 24px rgba(18,18,18,.035)}.v24-program-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.v24-program-head strong{font-size:12.5px;color:#2c2d2a}.v24-program-edit{min-height:32px;padding:0 11px;border:1px solid rgba(22,23,23,.08);border-radius:999px;background:#eeeae3;color:#5f5c56;font-size:9.8px;font-weight:750}.v24-program-row{display:flex;gap:7px;margin-top:11px;overflow-x:auto;scrollbar-width:none}.v24-program-row::-webkit-scrollbar{display:none}.v24-program{flex:1 0 auto;min-width:96px;min-height:47px;padding:8px 10px;border:1px solid rgba(22,23,23,.07);border-radius:14px;background:#f4f0e9;color:#5d5b56;text-align:left}.v24-program.active{background:#202121;color:#f5efe4;border-color:rgba(199,166,106,.20)}.v24-program b{display:block;font-size:10.5px}.v24-program span{display:block;margin-top:3px;font-size:8.4px;opacity:.68;white-space:nowrap}
.v24-actions-title{margin:18px 2px 9px;font-size:12px;font-weight:740;color:#484742}.v24-actions{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.v24-action{min-height:76px;padding:12px 10px;border:1px solid rgba(22,23,23,.075);border-radius:17px;background:rgba(255,254,250,.78);text-align:left;color:#292a27}.v24-action .ico{width:29px;height:29px;display:grid;place-items:center;border-radius:9px;background:#1d1e1e;color:#ead8b1}.v24-action .ico svg{width:14px;height:14px}.v24-action strong{display:block;margin-top:9px;font-size:10.5px;line-height:1.18}.v24-action span.copy{display:none}

