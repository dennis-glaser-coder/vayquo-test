    h.innerHTML=`<div class="card-light"><div class="tool-title"><i>${ic('plane')}</i><h3>Flug mit Punkten prüfen</h3></div><p class="desc">Wähle zuerst den Flug. VAYQUO braucht die Rechenwerte erst danach.</p><div class="v24-step"><div class="v24-step-head"><strong>Flug suchen</strong><span>1 · FLUG</span></div><div class="v23-flight-route"><div class="field"><label>Von</label><input class="input" id="fFrom" placeholder="DUS" autocapitalize="characters"></div><div class="field"><label>Nach</label><input class="input" id="fTo" placeholder="JFK" autocapitalize="characters"></div></div><div class="v23-flight-meta"><div class="field"><label>Reisedatum</label><input class="input" id="fDate" type="date"></div><div class="field"><label>Reiseklasse</label><select class="select" id="fCabin"><option>Economy</option><option>Premium Economy</option><option selected>Business</option><option>First</option></select></div></div><button class="btn v24-search-btn" id="v24SearchFlights">Flüge anzeigen</button><div id="v24FlightChoices"></div></div><div class="v24-step v24-award-box" id="v24AwardBox"><div class="v24-step-head"><strong>Punktebuchung ergänzen</strong><span>2 · PUNKTE</span></div><div class="v24-screenshot"><span><strong>Screenshot vorhanden?</strong><br>Später liest VAYQUO Punktepreis und Gebühren daraus automatisch aus.</span><button id="v24ScreenshotBtn" type="button">Screenshot</button><input id="v24Screenshot" type="file" accept="image/*" hidden></div><div id="v24ScanStatus" class="v24-scan-status"></div><div class="field"><label>Programm</label><select class="select" id="fProgram">${v24FlightProgramOptions()}</select></div><div class="field"><label>Prämienpreis im Programm ${v24HelpButton('award')}</label><input class="input" id="fAward" type="number" inputmode="numeric" placeholder="z. B. 55000"></div><div class="field"><label>Steuern & Gebühren ${v24HelpButton('fees')}</label><input class="input" id="fFees" type="number" inputmode="decimal" step="0.01" placeholder="z. B. 247"></div><div class="field"><label>Im Programm schon vorhanden ${v24HelpButton('have')}</label><input class="input" id="fHave" type="number" inputmode="numeric" value="0"></div><div class="field"><label>Dein Mindestwert ${v24HelpButton('min')}<small>Cent pro MR-Punkt</small></label><input class="input" id="fMin" type="number" step="0.1" value="${state.minCpp||1}"></div><details class="v24-manual"><summary>Flugdaten manuell ergänzen</summary><div class="field"><label>Barpreis desselben Fluges ${v24HelpButton('cash')}</label><input class="input" id="fCash" type="number" inputmode="decimal" step="0.01" placeholder="wird bei Live-Flugdaten automatisch übernommen"></div></details><button class="btn" id="calcF">Diesen Flug bewerten</button><div id="fRes"></div></div></div>`;
    const sel=document.getElementById('fProgram'),have=document.getElementById('fHave');if(sel&&have){have.value=v24HaveDefault(sel.value);sel.onchange=()=>{have.value=v24HaveDefault(sel.value)}}
    document.getElementById('v24SearchFlights').onclick=v24SearchFlights;document.getElementById('v24ScreenshotBtn').onclick=()=>document.getElementById('v24Screenshot').click();document.getElementById('v24Screenshot').onchange=v24ScreenshotChosen;document.getElementById('calcF').onclick=v24CalcFlight;v24BindHelp();
  }
  function v24SearchFlights(){
    const from=document.getElementById('fFrom').value.trim().toUpperCase(),to=document.getElementById('fTo').value.trim().toUpperCase(),date=document.getElementById('fDate').value,cabin=document.getElementById('fCabin').value;if(!from||!to){toast('Von und Nach eingeben');return}
    const list=v24DemoFlights(cabin),wrap=document.getElementById('v24FlightChoices');wrap.innerHTML=`<div class="v24-demo-note"><strong>UX-Demo:</strong> Noch keine Flugpreis-API verbunden. Diese Auswahl testet bereits den späteren Ablauf; die Preise sind ausdrücklich Beispieldaten.</div><div class="v24-flight-list">${list.map(x=>`<button class="v24-flight-option" data-v24-flight="${x.id}" data-price="${x.price}"><span><strong>${from} → ${to} · ${x.name}</strong><span>${date?date+' · ':''}${cabin} · ${x.meta}</span></span><span class="price"><b>${money(x.price)}</b><small>DEMO</small></span></button>`).join('')}</div>`;document.querySelectorAll('[data-v24-flight]').forEach(b=>b.onclick=()=>v24ChooseFlight(b));
  }
  function v24ChooseFlight(b){document.querySelectorAll('[data-v24-flight]').forEach(x=>x.classList.toggle('active',x===b));const box=document.getElementById('v24AwardBox');box.classList.add('visible');const cash=document.getElementById('fCash');cash.value=b.dataset.price;box.dataset.demo='1';box.scrollIntoView({behavior:'smooth',block:'start'});v24BindHelp()}
  function v24ScreenshotChosen(){const f=this.files?.[0],s=document.getElementById('v24ScanStatus');if(!f)return;s.innerHTML=`Screenshot <strong>${esc(f.name)}</strong> ausgewählt. Automatisches Auslesen ist in V2.4 noch nicht aktiv – die Werte kannst du unten ergänzen.`;}
